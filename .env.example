# ============================================================
# Wiki du IIIe Delphinat de Gratianopolis — Variables d'environnement
# Copiez ce fichier vers `.env` puis personnalisez les valeurs.
# ============================================================

# --- Comptes d'édition (sécurité) -----------------------------
# Les charges sont celles de la Constitution (article P-1) :
#   dauphin | regent | conseil | baillit | premier-ministre
#   | ministre | representant | depute
#
# Droits sur le wiki :
#   - dauphin                        : tout (suppression, synchronisation Discord)
#   - regent, conseil, baillit       : création, modification, restauration
#   - premier-ministre, ministre,
#     representant, depute           : consultation seule
#
# Format : identifiant:motdepasse:charge, séparés par des virgules
WIKI_USERS="esto:motdepasseDuDauphin:dauphin,baillit1:motdepasseDuBaillit:baillit"

# Clé secrète de signature des sessions (JWT HS256) — Générez-la :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Compatibilité : si WIKI_USERS est vide, ce compte unique (charge Dauphin) est utilisé.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi

# --- Synchronisation Discord (API officielle, données réelles) -------------
# 1. Créez une application sur https://discord.com/developers/applications
# 2. Onglet Bot → « Reset Token » → copiez le token ci-dessous
# 3. Activez « SERVER MEMBERS INTENT » dans l'onglet Bot (Privileged Gateway Intents)
# 4. Invitez le bot sur le serveur avec la permission « View Server Members »
#    (lien OAuth2 > URL Generator : scope "bot")
# 5. Récupérez l'ID du serveur : Paramètres → Paramètres avancés → Mode développeur,
#    puis clic droit sur le serveur → « Copier l'identifiant du serveur »
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Base de données (OBLIGATOIRE pour un déploiement) -------------------
# Laissez vide pour utiliser les fichiers JSON locaux (data/articles.json) : ce
# mode convient au développement local, et **seulement** cela.
#
# Sur Vercel (et toute plateforme sans écriture persistante), DATABASE_URL est
# OBLIGATOIRE : chaque invocation reçoit un système de fichiers distinct et en
# lecture seule. Sans base, le wiki s'afficherait vide et toute édition serait
# perdue. `npm run check:deploy` refuse de valider un tel déploiement.
#
# Localement :
#   1. docker compose up -d
#   2. node scripts/check-db.mjs
#   3. Renseignez DATABASE_URL ci-dessous, puis redémarrez (npm run dev)
#
# Sur Vercel : créez une base managée (Neon, Supabase, Railway…) et collez son
# URL de connexion ici. Le schéma est créé automatiquement au premier accès.
DATABASE_URL=

# TLS : décidé automatiquement selon l'hôte de DATABASE_URL.
#   - base distante (Neon, Supabase, Railway…) -> TLS activé, ils l'exigent ;
#   - base locale (localhost, 127.0.0.1, service Docker) -> TLS désactivé,
#     car un PostgreSQL local ne le supporte pas.
# Ces deux réglages forcent la main si le cas est ambigu :
# DATABASE_SSL=false   # jamais de TLS
# DATABASE_SSL=true    # toujours du TLS
# DATABASE_POOL_MAX=10
# DATABASE_TIMEOUT_MS=5000

# URL publique du site (sitemap.xml, robots.txt, OpenGraph).
# Facultative sur Vercel : l'URL y est déduite de VERCEL_PROJECT_PRODUCTION_URL.
# À renseigner uniquement pour un domaine personnalisé.
# SITE_URL=https://wiki.example.com

# --- Déploiement Vercel ----------------------------------------------------
# Secret de la tâche planifiée (discord). Vercel l'envoie dans l'en-tête
# « Authorization: Bearer … » à chaque appel de /api/cron/discord.
# Sans lui, la route répond 503 et la synchronisation automatique est désactivée.
# Générez-le : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# --- Intelligence artificielle (analyse automatique des salons) ----------
# L'IA lit les salons de parti et rédige des PROPOSITIONS de mise à jour.
# Elle ne publie jamais seule : chaque proposition attend une validation
# humaine dans /admin/ia.
#
# 1. Créez une clé sur https://aistudio.google.com/apikey
# 2. Collez-la ci-dessous
GEMINI_API_KEY=
# Modèle utilisé (facultatif). Par défaut : gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Pour lancer une analyse sans l'interface (tâche planifiée) :
#   WIKI_SESSION=<cookie gratianopolis_session> npm run ai:analyse
#   WIKI_SESSION=… npm run ai:analyse -- --simulation

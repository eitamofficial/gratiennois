# Dépendances
node_modules/

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Environnement (identifiants admin — ne jamais commit)
.env
.env*.local
.env.secrets
.env*.secrets

# Contenu édité à l'exécution (auto-généré au premier lancement)
data/

# Portraits Discord mis en cache (photos de profil : données personnelles,
# régénérables avec `npm run cache:avatars`, jamais versionnées)
public/avatars/

# Images téléversées depuis l'espace d'édition : contenu propre au site,
# produit à l'exécution. Les versionner gonflerait le dépôt à chaque envoi.
data/uploads/

# Dépendances des bots Discord (le site ne les utilise pas)
bot/node_modules/
bot/dist/
DelphinaBotV2/node_modules/

# Données du bot (réglages, niveaux, ducats, avertissements) : propres à
# l'installation, régénérées au premier démarrage.
DelphinaBotV2/data/

# Binaires téléchargés (yt-dlp, ~17 Mio) : chaque poste a le sien.
DelphinaBotV2/bin/

# Compilations temporaires des scripts de vérification
.tmp-check-*/

# Journaux des reverse proxies locaux (Windows et Termux)
deploy/windows/caddy.log
deploy/termux/*.log
*.log

# Dernière adresse IPv6 annoncée à DuckDNS (relève de sync-duckdns.ps1)
deploy/windows/duckdns-ipv6.txt

# Divers
.DS_Store
.neon

# Mémoire de travail de l'assistant : notes locales, pas du contenu du wiki
.workbuddy-ai/

# Fichiers temporaires de travail
tmp/
*.applique
tmp_*.py

# Binaires et données d'exécution du bot
DelphinaBotV2/bin/
DelphinaBotV2/data/
DelphinaBotV2/tmp/
DelphinaBotV2/*.log

# Dossiers de vérification de build (artefacts, jamais versionnés)
.next-*/

# =============================================================================
# DelphinaBot V2 — configuration
#
# Copiez ce fichier vers `.env`, puis renseignez les deux valeurs
# indispensables. Tout le reste a une valeur par défaut raisonnable.
#
#     cp .env.example .env
# =============================================================================

# --- Indispensables ---------------------------------------------------------

# Jeton du bot Discord.
# https://discord.com/developers/applications → votre application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Identifiant de l'application (sert à construire le lien d'invitation).
# Il s'affiche sur la même page que le jeton, sous « Application ID ».
DISCORD_CLIENT_ID=

# Identifiant du serveur Discord où le bot travaille.
# Clic droit sur le serveur (mode développeur activé) → « Copier l'identifiant ».
DISCORD_GUILD_ID=

# --- Wiki (facultatif mais recommandé) --------------------------------------

# Adresse publique du wiki, sans barre finale.
WIKI_URL=

# Secret HMAC-SHA256 partagé avec le wiki. Il doit être **identique** à la
# valeur `BOT_SYNC_SECRET` du fichier `.env` du wiki : sans lui, aucune
# synchronisation de rôles n'est possible et le bot le dit au démarrage.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_SYNC_SECRET=

# --- Membres autorisés à tout ----------------------------------------------

# Identifiants Discord séparés par des virgules. Ces membres peuvent tout,
# y compris ce que Discord ne permet pas au bot.
PROPRIETAIRES_IDS=

# --- Binaires (facultatif) --------------------------------------------------

# yt-dlp : chemin du binaire. Laissé vide, le bot cherche bin/yt-dlp.exe
# (Windows) ou bin/yt-dlp, puis le PATH — c'est ce qu'il faut sur Termux, où
# `pkg install yt-dlp` ou `pip install -U yt-dlp` fait le travail.
# Téléchargement : https://github.com/yt-dlp/yt-dlp/releases
CHEMIN_YTDLP=

# ffmpeg : laissé vide, le bot prend celui de ffmpeg-static, puis celui du PATH.
# Sur une tablette Android, celui de la dépendance ne s'exécute pas : c'est
# `pkg install ffmpeg` qui compte, et la recherche automatique le trouve.
CHEMIN_FFMPEG=

# --- Réglages (facultatif) --------------------------------------------------

# debug, info, warn, error
NIVEAU_LOG=info

# Durée maximale d'un morceau, en secondes (7200 = deux heures).
DUREE_MUSIQUE_MAX=7200

# Volume de départ de la musique, de 0 à 100.
VOLUME_DEFAUT=40

# Attente avant de quitter un salon vocal une fois la file vide, en secondes.
# Cinq minutes par défaut : le temps d'ajouter un morceau entre deux. Mettre 0
# ramène le comportement d'origine, qui quittait le salon aussitôt.
DELAI_QUITTER_VOCAL_SECONDES=300

# Reprises d'un morceau interrompu en cours de route, avant de passer au
# suivant. La reprise se fait depuis le début, seul yt-dlp sachant reprendre un
# flux sans le retélécharger. Mettre 0 pour ne jamais reprendre.
TENTATIVES_MUSIQUE=2

# Silence toléré avant d'abandonner un flux, en cycles d'affichage (un cycle
# vaut environ 20 ms). La valeur de la bibliothèque vocale est 5 — cent
# millisecondes : c'est elle qui faisait s'arrêter la musique « toute seule » au
# premier hoquet du réseau. Ne descendez pas sous 25.
TOLERANCE_SILENCE_IMAGES=50

# Niveaux : expérience par message, délai anti-répétition, palier de progression.
XP_PAR_MESSAGE=15
DELAI_XP_SECONDES=60
PALIER_XP=100

# --- Services musicaux facultatifs ------------------------------------------

# Paroles : avec un jeton, l'API officielle de Genius est utilisée plutôt que
# la lecture de la page publique (plus stable).
GENIUS_TOKEN=

# Albums et playlists Spotify : demandent des identifiants. Un morceau isolé
# fonctionne sans eux, les métadonnées étant lues sur la page publique.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Salon d'API musicales facultatif ---------------------------------------

# Clé Last.fm (statistiques d'écoute). Sans elle, la commande correspondante
# refuse explicitement au lieu d'échouer en silence.
LASTFM_API_KEY=

# ---------------------------------------------------------------------------
# DelphinaBot — variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env` (jamais versionné) et renseignez-le. Le bot le
# charge lui-même au démarrage, sans dépendance externe.
#
# Rappel : un jeton Discord est un mot de passe. S'il fuit, quelqu'un peut
# prendre le contrôle du bot et de tous les serveurs où il est présent.
# Révoquez-le immédiatement sur https://discord.com/developers/applications
# ---------------------------------------------------------------------------

# --- Obligatoire ------------------------------------------------------------

# Jeton du bot (Developer Portal > Bot > Reset Token).
DISCORD_BOT_TOKEN=

# Identifiant de l'application (Developer Portal > General Information).
DISCORD_CLIENT_ID=

# Base de données. La même base PostgreSQL que le wiki convient : le bot y
# crée ses propres tables, préfixées `delphinabot_`.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require


# --- Facultatif, mais fortement conseillé -----------------------------------

# Serveur de référence. Renseigner son identifiant rend le déploiement des
# commandes instantané (le portail Discord peut propager jusqu'à une heure).
DISCORD_GUILD_ID=

# Racine publique du wiki, utilisée pour les liens de l'économie et la
# synchronisation des rôles.
WIKI_URL=https://wiki-gratiennois.duckdns.org

# Secret partagé avec le wiki : il signe les échanges entre les deux.
# Identique à la variable du même nom côté site.
BOT_SYNC_SECRET=

# Identifiants des membres autorisés à utiliser les commandes d'administration
# du bot, séparés par des virgules.
PROPRIETAIRES_IDS=

# Rôles de repli, utilisés quand un serveur n'a pas encore été configuré avec
# /configurer. La configuration par serveur (/configurer) prime toujours.
ROLE_ADMIN_ID=
ROLE_MODERATION_ID=
ROLE_MUTE_ID=
ROLE_DJ_ID=

# Préfixe des commandes textuelles (!aide, !wiki...). Les commandes
# principales sont des /commandes Discord : rien à taper.
PREFIXE=!

# Chemins des exécutables de musique. FFmpeg est indispensable à la voix ;
# yt-dlip sert à résoudre un morceau YouTube en URL audio directe.
CHEMIN_FFMPEG=ffmpeg
CHEMIN_YTDLP=yt-dlp

# Niveau de journalisation : debug | info | warn | error
NIVEAU_LOG=info

# Durée maximale d'une musique, en minutes (garde-fou Discord).
DUREE_MUSIQUE_MAX=180

# Nombre de messages/jour/membre qui rapportent de l'XP et des ducats.
MESSAGES_PAR_JOUR_XP=100

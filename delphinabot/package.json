{
  "name": "delphinabot",
  "version": "1.0.0",
  "private": true,
  "description": "DelphinaBot — bot Discord du IIIe Delphinat de Gratianopolis : securite, moderation, anti-raid, fun, economie et musique. Entierement francophone.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "commandes": "node dist/scripts/deploy-commandes.js",
    "commandes:verifier": "node dist/scripts/verifier-commandes.js",
    "essai": "node dist/scripts/essai-base.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.16.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3"
  }
}

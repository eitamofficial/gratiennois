#!/data/data/com.termux/files/usr/bin/bash
# Service Termux du wiki.
#
# À installer dans $PREFIX/var/service/wiki/run, puis `sv-enable wiki`.
#
# Deux particularités de Termux expliquent la forme de ce script. D'abord, un
# service doit rester au premier plan : termux-services surveille le processus, et
# un script qui rend la main est considéré comme terminé — le service s'éteindrait
# aussitôt. Ensuite, il n'y a pas de systemd : c'est ce mécanisme qui relance un
# service après un plantage. Sans la boucle ci-dessous, le premier hoquet de
# réseau qui tue `next start` laisserait le wiki éteint jusqu'au prochain
# redémarrage de la tablette.
#
# Variables lues dans l'environnement du service (voir env.exemple) :
#   WIKI_DIR   répertoire du projet
#   WIKI_PORT  port d'écoute local, que Caddy relaie

set -u

: "${WIKI_DIR:=$HOME/wiki}"
: "${WIKI_PORT:=3000}"
: "${WIKI_RETRY:=15}"

journalier() {
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

cd "$WIKI_DIR" || {
  journalier "IMPOSSIBLE d'entrer dans $WIKI_DIR"
  # Sortir en erreur ferait croire à un plantage du script lui-même, alors que le
  # problème est ailleurs. La boucle ci-dessous reprend indéfiniment.
  while true; do sleep 60; done
}

journalier "démarrage du wiki sur le port $WIKI_PORT"

while true; do
  # `next start` ne lit pas le fichier .env : sur Vercel c'est la plateforme qui
  # fournit les variables, ici il faut les exporter nous-mêmes avant de lancer.
  if [ -f .env ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env
    set +a
    journalier "variables chargées depuis .env"
  else
    journalier "AUCUN fichier .env dans $WIKI_DIR — le wiki partira sans configuration"
  fi

  # Les identifiants d'édition vivent dans un fichier séparé, et ce n'est pas
  # un détail de rangement. Next.js relit `.env` à son démarrage et y interprète
  # les `$` comme des références de variables : une empreinte scrypt
  # (`scrypt$sel$empreinte`) y perd ses deux séparateurs, `startsWith("scrypt$")`
  # devient faux, et la vérification retombe sur une comparaison en clair qui
  # échoue toujours. Le symptôme est un « Identifiants incorrects » alors que le
  # mot de passe est bon. Ce fichier-ci n'est pas connu de Next : sa valeur
  # arrive intacte.
  if [ -f .env.secrets ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env.secrets
    set +a
    journalier "identifiants chargés depuis .env.secrets"
  fi

  # `--hostname 127.0.0.1` : le serveur n'écoute plus que sur la boucle locale.
  # Sans cela, `next start` écoute sur 0.0.0.0 et le wiki reste consultable en
  # clair sur http://<ip-de-la-tablette>:3000 depuis le réseau local, ce qui
  # contourne complètement Caddy et le HTTPS. Caddy relaie vers 127.0.0.1:3000 :
  # le site n'est donc plus joignable que par le portier, en TLS.
  #
  # **Pourquoi `node .../bin/next` et non `npm run start`** : le binaire
  # `node_modules/.bin/next` commence par `#!/usr/bin/env node`, et Android
  # n'a pas de `/usr/bin/env`. Termux le rattrape normalement par `termux-exec`,
  # qui réécrit le shebang à l'exécution — mais ce préchargement n'existe pas
  # dans tous les contextes (service lancé par `su` depuis le script de boot,
  # par exemple). Le binaire était alors « introuvable » alors qu'il était bien
  # là, et le service bouclait sur un code 127. Passer par `node` supprime la
  # question : plus de shebang à interpréter.
  node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port "$WIKI_PORT"
  code=$?
  journalier "le wiki s'est arrêté (code $code), nouvelle tentative dans ${WIKI_RETRY}s"
  sleep "$WIKI_RETRY"
done

# Caddyfile — reverse proxy vers le wiki, sur Windows.
#
# Mêmes principes que `deploy/termux/Caddyfile`, avec les différences qui
# tiennent à la machine : où sont les journaux, comment on démarre le service.
#
# ## Deux modes, un seul interrupteur
#
#   WIKI_SCHEME=http://    → HTTP simple sur le port 80. Aucun certificat
#                            demandé, aucune redirection. C'est le mode de
#                            départ : le wiki répond sans rien ouvrir d'autre.
#   WIKI_SCHEME=https://   → HTTPS automatique, certificat obtenu et renouvelé
#                            par Caddy, redirection du HTTP vers le HTTPS.
#
# Le préfixe `http://` désactive le HTTPS automatique. Sans lui, Caddy redirige
# systématiquement le HTTP vers le HTTPS — même quand aucun certificat n'a pu
# être obtenu, faute de port 80 joignable. Le site devient alors injoignable sur
# les deux ports, sans que rien n'indique que c'est la box qui est en cause.
#
# Sur cette machine, la variable se lit dans l'environnement du service
# (`voir demarrer-caddy.bat`), ou se règle pour la session avec :
#
#   setx WIKI_SCHEME http://

# Le domaine public, plus `localhost` et l'adresse de boucle.
#
# Servir les trois n'est pas un détail : Caddy n'accepte que le premier nom
# d'hôte déclaré et renvoie une **page vide** pour tous les autres — un code
# 200 sans le moindre octet. Taper `http://localhost` dans le navigateur donne
# donc un écran blanc, ce qui se confond exactement avec un site inaccessible.
# Déclarer aussi les adresses locales rend le test immédiat sur la machine,
# sans toucher au DNS ni attendre la redirection de port.
{$WIKI_SCHEME:http://}{$WIKI_DOMAINE:localhost}, http://localhost, http://127.0.0.1 {
	encode zstd gzip

	# Aucun en-tête de sécurité ici : l'application les pose elle-même, dans
	# `src/middleware.ts`, en ajustant la CSP au protocole réel. Voir
	# `src/lib/security-headers.ts` pour pourquoi cette distinction compte.

	# Next.js rend ses propres fichiers et les étiquette lui-même ; on ne force
	# rien, ce qui casserait les pages rendues dynamiquement.
	reverse_proxy 127.0.0.1:{$WIKI_PORT:3000} {
		# La page d'accueil interroge la base à chaque visite. Sans ce délai,
		# une base lente ferait expire la requête du navigateur alors que le
		# serveur répond encore.
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}
}

# En mode `https://`, Caddy crée lui-même la redirection du port 80 vers le
# 443. Rien à écrire ici : la dédupliquer ne servirait qu'à la rendre active en
# mode `http://`, où le wiki doit rester joignable en clair.
#
# Pour que Let's Encrypt valide le domaine, le port 80 doit être joignable
# depuis Internet — donc redirigé sur la box vers ce PC, avec une IP fixe
# attribuée par le DHCP. C'est la seule étape qui ne dépende pas de la machine.
#
# Tant qu'elle n'est pas faite, `http://wiki-gratiennois.duckdns.org` reste
# injoignable, y compris depuis cette machine : le nom pointe vers l'adresse
# publique de la box, qui ne sait pas encore revenir ici. Ce n'est pas une
# panne — le domaine répond dès que la redirection existe. Pour vérifier en
# attendant, utilisez `http://localhost`.
